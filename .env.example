# PostgreSQL local (dev). En production, DATABASE_URL est une variable Render (pooler Supabase).
DATABASE_URL="postgresql://fildesable:CHANGE_ME@localhost:5432/fildesable"

# Production sur Supabase : ces deux variables vont dans .env.production.local (jamais versionne).
# Voir README, « Base Supabase ».
# PROD_DATABASE_URL : pooler en mode transaction (port 6543), a copier dans la variable Render DATABASE_URL.
# PROD_MIGRATE_URL  : connexion directe ou pooler en mode session (port 5432), pour prisma migrate.
# PROD_DATABASE_URL="postgresql://postgres.REF:MOTDEPASSE@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?sslmode=require"
# PROD_MIGRATE_URL="postgresql://postgres.REF:MOTDEPASSE@aws-0-eu-west-3.pooler.supabase.com:5432/postgres?sslmode=require"

# Optionnel : certificat racine (PEM) de l'autorite qui signe le certificat TLS de la base.
# S'il est renseigne, la chaine est verifiee ; sinon la connexion est chiffree sans verification
# (cas de Supabase, autorite privee). Sauts de ligne reels ou "\n".
DB_SSL_CA=""

# Compte administrateur cree par `pnpm db:seed`.
# Mot de passe obligatoire, propre a chaque environnement, 14 caracteres minimum (le seed refuse sinon).
# Pour en generer un : node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""

# Fournisseur de paiement : "mock" en dev (desactive automatiquement en production) ou "stripe".
PAYMENT_PROVIDER="mock"

# Stripe (PAYMENT_PROVIDER="stripe") : cles de TEST d'abord (sk_test_..., whsec_...).
# En local, le secret du webhook est affiche par : stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# URL publique du site (redirections Stripe). Jamais deduite de l'en-tete Host.
APP_URL="http://localhost:3000"
