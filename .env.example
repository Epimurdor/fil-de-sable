# SQLite en dev. En prod : provider "postgresql" dans prisma/schema.prisma et une URL postgres ici.
DATABASE_URL="file:./dev.db"

# Compte administrateur cree par `pnpm db:seed`
SEED_ADMIN_EMAIL="admin@fildesable.fr"
