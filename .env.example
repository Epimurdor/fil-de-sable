# PostgreSQL local (dev). En production sur Wasmer, la base est fournie via DB_HOST/DB_PORT/DB_NAME/DB_USERNAME/DB_PASSWORD.
# Pour viser la base Wasmer depuis ton poste (migrations), ajoute ?sslmode=require a l'URL.
DATABASE_URL="postgresql://fildesable:CHANGE_ME@localhost:5432/fildesable"

# Optionnel : certificat racine (PEM) de l'autorite qui signe le certificat TLS de la base.
# S'il est renseigne, la chaine est verifiee ; sinon la connexion est chiffree sans verification
# (cas de la base managee Wasmer, autorite privee). Sauts de ligne reels ou "\n".
DB_SSL_CA=""

# Compte administrateur cree par `pnpm db:seed`.
# Mot de passe obligatoire, propre a chaque environnement, 14 caracteres minimum (le seed refuse sinon).
# Pour en generer un : node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""

# Fournisseur de paiement : "mock" en dev (desactive automatiquement en production) ou "stripe".
PAYMENT_PROVIDER="mock"

# Stripe (PAYMENT_PROVIDER="stripe") : cles de TEST d'abord (sk_test_..., whsec_...).
# En local, le secret du webhook est affiche par : stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# URL publique du site (redirections Stripe). Jamais deduite de l'en-tete Host.
APP_URL="http://localhost:3000"
